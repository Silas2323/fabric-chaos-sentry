# Template only. Copy to secret.local.yml (gitignored via *.local.yml),
# fill in real values there, and apply that copy. Never commit real creds.
# Ends in .example on purpose: `kubectl apply -f chaos/deploy/` skips it.
apiVersion: v1
kind: Secret
metadata:
  name: switch-creds
  namespace: fabric-chaos
type: Opaque
stringData:
  username: CHANGE_ME
  password: CHANGE_ME
